    <string name="toast_fallback_internal_permission_denied">未获得共享存储权限，本次使用内部存储；/sdcard/AMCode 文件保持不变</string>
    <string name="toast_shared_access_not_granted">未获得共享存储权限</string>
    <string name="toast_shared_access_granted">已获得共享存储访问权限</string>
    <string name="toast_notification_permission_needed">需要通知权限以保持 VS Code 在后台运行</string>
    <string name="toast_external_not_writable_keep_internal">/sdcard/AMCode 当前不可写，保持内部存储</string>
